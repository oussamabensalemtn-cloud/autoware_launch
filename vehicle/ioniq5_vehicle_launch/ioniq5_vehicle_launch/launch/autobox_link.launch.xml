<?xml version="1.0" encoding="UTF-8"?>
<!-- Link to the MicroAutoBox: Autoware trajectory -> bridge -> UDP trajectory (44444) and trajectory status (44445).
     Included by vehicle_interface.launch.xml (car) and by mrm_planning_simulator.launch.xml (bench test with the MABX). -->
<launch>
  <arg name="trajectory_input_topic" default="/planning/trajectory"/>
  <!-- UDP target (127.0.0.1 = dry run, nothing reaches the Autobox) -->
  <arg name="autobox_ip" default="10.0.10.20"/>
  <!-- trajectory status port, 0 = off -->
  <arg name="autobox_status_port" default="44445"/>
  <!-- source field of the status: 2 = MRM stack (/mrm/trajectory, valid needs /mrm/status), 1 = standard stack -->
  <let name="trajectory_source" value="$(eval '2 if &quot;$(var trajectory_input_topic)&quot; == &quot;/mrm/trajectory&quot; else 1')"/>
  <!-- MRM-004: age <= 0.1 s for the MRM trajectory; Autoware's planning publishes at about 10 Hz -->
  <let name="status_max_age_s" value="$(eval '0.1 if $(var trajectory_source) == 2 else 0.3')"/>

  <!-- Autoware trajectory -> smoothed trajectory (t, x, y, yaw, v, a, s, kappa) -->
  <node pkg="ioniq5_vehicle_launch" exec="autobox_trajectory_bridge.py" name="autobox_trajectory_bridge" output="screen">
    <param name="input_topic" value="$(var trajectory_input_topic)"/>
    <param name="output_topic" value="/HI5/autoware_controller_trajectory"/>
    <param name="resample_ds" value="0.2"/>
    <param name="smoothing_length_m" value="8.0"/>
    <param name="max_deviation_m" value="0.10"/>
    <!-- the UDP window reaches at most 24 m ahead (24 points, <= 1 m apart); Autoware's trajectory starts a few m
         behind the car. 60 m leaves room for both up to 50 km/h -->
    <param name="max_output_length_m" value="60.0"/>
  </node>

  <!-- smoothed trajectory -> 31-point UDP packet (format version 3) for the Autobox (44444),
       plus the trajectory status packet at 50 Hz (44445) -->
  <node pkg="ioniq5_vehicle_launch" exec="autobox_udp_sender.py" name="autobox_udp_sender" output="screen">
    <param name="input_topic" value="/HI5/autoware_controller_trajectory"/>
    <param name="autobox_ip" value="$(var autobox_ip)"/>
    <param name="autobox_port" value="44444"/>
    <param name="local_port" value="0"/>
    <param name="n_behind" value="6"/>
    <param name="behind_spacing_m" value="0.5"/>
    <!-- points ahead: the heading changes <= max_heading_step_deg and the time <= max_time_step_s between two points,
         spacing within [min_spacing_m, max_spacing_m]. The MABX interpolates linearly on s and t, so corners get
         < 0.3 m (R = 30 m: 0.29 m, R <= 26 m: 0.25 m), straights 1 m (R >= 105 m). min_horizon: warning only -->
    <param name="min_spacing_m" value="0.25"/>
    <param name="max_spacing_m" value="1.0"/>
    <param name="max_heading_step_deg" value="0.55"/>
    <param name="max_time_step_s" value="0.2"/>
    <param name="min_horizon" value="1.0"/>
    <param name="status_port" value="$(var autobox_status_port)"/>
    <param name="status_rate_hz" value="50.0"/>
    <param name="trajectory_source" value="$(var trajectory_source)"/>
    <param name="status_max_age_s" value="$(var status_max_age_s)"/>
    <param name="mrm_status_topic" value="/mrm/status"/>
  </node>
</launch>
