<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="vehicle_id" default="$(env VEHICLE_ID default)"/>
  <!-- trajectory that is sent to the Autobox (the MRM stack sets this to /mrm/trajectory) -->
  <arg name="trajectory_input_topic" default="/planning/trajectory"/>
  <!-- UDP target of the trajectory packets (127.0.0.1 = dry run, nothing reaches the Autobox) -->
  <arg name="autobox_ip" default="10.0.10.20"/>
  <!-- trajectory status for the Autobox (is the trajectory on 44444 up to date and valid?), 0 = off -->
  <arg name="autobox_status_port" default="44445"/>
  <!-- The car's sensors (Ouster driver, cameras, ANavS GNSS/IMU/twist, steering) publish in sensor_domain. If Autoware
       runs in another ROS_DOMAIN_ID (e.g. 101, next to the nominal AD system in 0), domain_bridge copies the topics in
       config/domain_bridge.yaml into it. Nothing goes back: the trajectory to the Autobox uses UDP. -->
  <arg name="sensor_domain" default="0" description="ROS_DOMAIN_ID in which the car's sensors publish"/>
  <arg name="domain_bridge" default="true" description="bridge the sensor topics if ROS_DOMAIN_ID differs from sensor_domain"/>
  <arg name="domain_bridge_config" default="$(find-pkg-share ioniq5_vehicle_launch)/config/domain_bridge.yaml"/>

  <let name="ros_domain" value="$(env ROS_DOMAIN_ID 0)"/>
  <let name="start_domain_bridge" value="$(eval '&quot;$(var domain_bridge)&quot;.lower() == &quot;true&quot; and &quot;$(var ros_domain)&quot; != &quot;$(var sensor_domain)&quot;')"/>
  <node pkg="domain_bridge" exec="domain_bridge" name="ioniq5_domain_bridge" output="screen" if="$(var start_domain_bridge)"
        args="--from $(var sensor_domain) --to $(var ros_domain) $(var domain_bridge_config)"/>

  <node pkg="ioniq5_vehicle_launch" exec="vehicle_status_publisher.py" name="vehicle_status_publisher" output="screen"/>

  <!-- trajectory bridge + UDP sender (trajectory 44444, status 44445), shared with the MRM simulator -->
  <include file="$(find-pkg-share ioniq5_vehicle_launch)/launch/autobox_link.launch.xml">
    <arg name="trajectory_input_topic" value="$(var trajectory_input_topic)"/>
    <arg name="autobox_ip" value="$(var autobox_ip)"/>
    <arg name="autobox_status_port" value="$(var autobox_status_port)"/>
  </include>
</launch>